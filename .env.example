# Copy to .env and adjust. Never commit .env.

# Port on the host (Docker) or the port the app listens on (no Docker).
PORT=8080

# Cafe timezone: decides "today" for order numbers and reports.
TZ_CAFE=Asia/Riyadh

# Set to 1 when the app is served over HTTPS through a reverse proxy (Caddy / Nginx / Cloudflare Tunnel).
COOKIE_SECURE=0

# Optional. If empty, a random secret is created once and stored in the data folder (.secret).
# Changing it signs everyone out.
SESSION_SECRET=
